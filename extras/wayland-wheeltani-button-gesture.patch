diff --git a/crates/middle-scroll-linux/src/button_gesture.rs b/crates/middle-scroll-linux/src/button_gesture.rs
new file mode 100644
index 0000000..85dc46e
--- /dev/null
+++ b/crates/middle-scroll-linux/src/button_gesture.rs
@@ -0,0 +1,260 @@
+//! Hold-a-button-and-scroll gesture.
+//!
+//! While the configured button (for example the thumb's back button) is held,
+//! wheel detents run `on_wheel_up` / `on_wheel_down` instead of scrolling.
+//! A plain tap, with no wheel turned while it was down, is replayed as a
+//! normal click on release, so the button keeps its usual job.
+//!
+//! Commands are spawned without waiting, rate-limited so a fast spin cannot
+//! queue dozens of processes.
+
+use std::process::{Command, Stdio};
+use std::time::{Duration, Instant};
+
+use evdev::{EventSummary, InputEvent, KeyCode, RelativeAxisCode};
+use middle_scroll_core::MouseButton;
+use tracing::{debug, warn};
+
+#[derive(Debug, Clone, Default, PartialEq, Eq)]
+pub struct ButtonGestureConfig {
+    /// Which button arms the gesture: "side", "extra", "forward" or "back"
+    /// (`BTN_SIDE`, `BTN_EXTRA`, ...). Empty disables the gesture.
+    pub button: String,
+    pub on_wheel_up: Vec<String>,
+    pub on_wheel_down: Vec<String>,
+    pub min_interval_ms: u64,
+}
+
+/// What the event loop should do with an input event.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Outcome {
+    /// Not ours: route the event as usual.
+    Pass,
+    /// Swallowed by the gesture.
+    Consumed,
+    /// The button was tapped without scrolling: emit a full click now.
+    Click(MouseButton),
+}
+
+#[derive(Debug)]
+pub struct ButtonGesture {
+    key: Option<(KeyCode, MouseButton)>,
+    on_up: Vec<String>,
+    on_down: Vec<String>,
+    min_interval: Duration,
+    held: bool,
+    used: bool,
+    last_fire: Option<Instant>,
+}
+
+fn parse_button(name: &str) -> Option<(KeyCode, MouseButton)> {
+    match name.trim().to_ascii_lowercase().trim_start_matches("btn_") {
+        "side" => Some((KeyCode::BTN_SIDE, MouseButton::Side)),
+        "extra" => Some((KeyCode::BTN_EXTRA, MouseButton::Extra)),
+        "forward" => Some((KeyCode::BTN_FORWARD, MouseButton::Forward)),
+        "back" => Some((KeyCode::BTN_BACK, MouseButton::Back)),
+        _ => None,
+    }
+}
+
+impl ButtonGesture {
+    pub fn new(config: &ButtonGestureConfig) -> Self {
+        let key = if config.button.trim().is_empty() {
+            None
+        } else {
+            let parsed = parse_button(&config.button);
+            if parsed.is_none() {
+                warn!(button = %config.button, "unknown [button_gesture] button; gesture disabled");
+            }
+            parsed
+        };
+        Self {
+            key,
+            on_up: config.on_wheel_up.clone(),
+            on_down: config.on_wheel_down.clone(),
+            min_interval: Duration::from_millis(config.min_interval_ms),
+            held: false,
+            used: false,
+            last_fire: None,
+        }
+    }
+
+    pub const fn enabled(&self) -> bool {
+        self.key.is_some()
+    }
+
+    /// Forget a half-finished gesture (device unplugged mid-hold).
+    pub fn reset(&mut self) {
+        self.held = false;
+        self.used = false;
+    }
+
+    pub fn handle(&mut self, event: &InputEvent) -> Outcome {
+        self.handle_at(event, Instant::now(), true)
+    }
+
+    fn handle_at(&mut self, event: &InputEvent, now: Instant, spawn: bool) -> Outcome {
+        let Some((code, button)) = self.key else {
+            return Outcome::Pass;
+        };
+        match event.destructure() {
+            EventSummary::Key(_, key, value) if key == code => match value {
+                1 => {
+                    self.held = true;
+                    self.used = false;
+                    Outcome::Consumed
+                }
+                0 if self.held => {
+                    self.held = false;
+                    if self.used {
+                        Outcome::Consumed
+                    } else {
+                        Outcome::Click(button)
+                    }
+                }
+                // Autorepeat or a release we never saw pressed.
+                _ => Outcome::Consumed,
+            },
+            EventSummary::RelativeAxis(_, RelativeAxisCode::REL_WHEEL, value) if self.held => {
+                self.used = true;
+                if value != 0 && self.ready(now) {
+                    self.last_fire = Some(now);
+                    let argv = if value > 0 { &self.on_up } else { &self.on_down };
+                    if spawn {
+                        run(argv);
+                    }
+                }
+                Outcome::Consumed
+            }
+            // The legacy wheel event above drives the commands; its high-res
+            // twin in the same frame must not leak through as a scroll.
+            EventSummary::RelativeAxis(_, RelativeAxisCode::REL_WHEEL_HI_RES, _) if self.held => {
+                self.used = true;
+                Outcome::Consumed
+            }
+            _ => Outcome::Pass,
+        }
+    }
+
+    fn ready(&self, now: Instant) -> bool {
+        self.last_fire
+            .is_none_or(|t| now.saturating_duration_since(t) >= self.min_interval)
+    }
+}
+
+fn run(argv: &[String]) {
+    let Some((program, args)) = argv.split_first() else {
+        return;
+    };
+    match Command::new(program)
+        .args(args)
+        .stdin(Stdio::null())
+        .stdout(Stdio::null())
+        .stderr(Stdio::null())
+        .spawn()
+    {
+        Ok(mut child) => {
+            debug!(%program, "button gesture command spawned");
+            std::thread::spawn(move || {
+                let _ = child.wait();
+            });
+        }
+        Err(err) => warn!(?err, %program, "failed to spawn button gesture command"),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use evdev::EventType;
+
+    fn key(code: KeyCode, value: i32) -> InputEvent {
+        InputEvent::new(EventType::KEY.0, code.0, value)
+    }
+
+    fn wheel(value: i32) -> InputEvent {
+        InputEvent::new(EventType::RELATIVE.0, RelativeAxisCode::REL_WHEEL.0, value)
+    }
+
+    fn hires(value: i32) -> InputEvent {
+        InputEvent::new(EventType::RELATIVE.0, RelativeAxisCode::REL_WHEEL_HI_RES.0, value)
+    }
+
+    fn motion() -> InputEvent {
+        InputEvent::new(EventType::RELATIVE.0, RelativeAxisCode::REL_X.0, 3)
+    }
+
+    fn gesture() -> ButtonGesture {
+        ButtonGesture::new(&ButtonGestureConfig {
+            button: "side".into(),
+            on_wheel_up: vec!["true".into()],
+            on_wheel_down: vec!["true".into()],
+            min_interval_ms: 100,
+        })
+    }
+
+    #[test]
+    fn tap_without_scroll_replays_a_click() {
+        let mut g = gesture();
+        let t = Instant::now();
+        assert_eq!(g.handle_at(&key(KeyCode::BTN_SIDE, 1), t, false), Outcome::Consumed);
+        assert_eq!(g.handle_at(&key(KeyCode::BTN_SIDE, 0), t, false), Outcome::Click(MouseButton::Side));
+    }
+
+    #[test]
+    fn scrolling_while_held_is_swallowed_and_suppresses_the_click() {
+        let mut g = gesture();
+        let t = Instant::now();
+        g.handle_at(&key(KeyCode::BTN_SIDE, 1), t, false);
+        assert_eq!(g.handle_at(&hires(-120), t, false), Outcome::Consumed);
+        assert_eq!(g.handle_at(&wheel(-1), t, false), Outcome::Consumed);
+        assert_eq!(g.handle_at(&key(KeyCode::BTN_SIDE, 0), t, false), Outcome::Consumed);
+    }
+
+    #[test]
+    fn wheel_passes_through_when_not_held() {
+        let mut g = gesture();
+        let t = Instant::now();
+        assert_eq!(g.handle_at(&wheel(1), t, false), Outcome::Pass);
+        assert_eq!(g.handle_at(&hires(120), t, false), Outcome::Pass);
+    }
+
+    #[test]
+    fn motion_and_other_buttons_always_pass() {
+        let mut g = gesture();
+        let t = Instant::now();
+        g.handle_at(&key(KeyCode::BTN_SIDE, 1), t, false);
+        assert_eq!(g.handle_at(&motion(), t, false), Outcome::Pass);
+        assert_eq!(g.handle_at(&key(KeyCode::BTN_LEFT, 1), t, false), Outcome::Pass);
+        assert_eq!(g.handle_at(&key(KeyCode::BTN_EXTRA, 1), t, false), Outcome::Pass);
+    }
+
+    #[test]
+    fn rate_limit_drops_detents_inside_the_interval() {
+        let mut g = gesture();
+        let t = Instant::now();
+        g.handle_at(&key(KeyCode::BTN_SIDE, 1), t, false);
+        g.handle_at(&wheel(1), t, false);
+        assert_eq!(g.last_fire, Some(t));
+        g.handle_at(&wheel(1), t + Duration::from_millis(50), false);
+        assert_eq!(g.last_fire, Some(t));
+        let later = t + Duration::from_millis(120);
+        g.handle_at(&wheel(1), later, false);
+        assert_eq!(g.last_fire, Some(later));
+    }
+
+    #[test]
+    fn empty_button_disables_everything() {
+        let mut g = ButtonGesture::new(&ButtonGestureConfig::default());
+        assert!(!g.enabled());
+        assert_eq!(g.handle(&key(KeyCode::BTN_SIDE, 1)), Outcome::Pass);
+    }
+
+    #[test]
+    fn button_names_parse() {
+        assert!(parse_button("BTN_SIDE").is_some());
+        assert!(parse_button("extra").is_some());
+        assert!(parse_button("Forward").is_some());
+        assert!(parse_button("middle").is_none());
+    }
+}
