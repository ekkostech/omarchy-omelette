+/// On-disk `[button_gesture]` section: hold a mouse button and turn the wheel
+/// to run commands; a plain tap still clicks.
+#[derive(Debug, Clone, Default, Serialize, Deserialize)]
+#[serde(default, deny_unknown_fields)]
+pub struct ButtonGestureFileConfig {
+    pub button: Option<String>,
+    pub on_wheel_up: Option<Vec<String>>,
+    pub on_wheel_down: Option<Vec<String>>,
+    pub min_interval_ms: Option<u64>,
+}
+
+impl ButtonGestureFileConfig {
+    pub fn into_resolved(self) -> ButtonGestureConfig {
+        ButtonGestureConfig {
+            button: self.button.unwrap_or_default(),
+            on_wheel_up: self.on_wheel_up.unwrap_or_default(),
+            on_wheel_down: self.on_wheel_down.unwrap_or_default(),
+            min_interval_ms: self.min_interval_ms.unwrap_or(110),
+        }
+    }
+}
+
 /// On-disk representation of a stable mouse identifier. Survives reboots and
 /// USB renumbering because it does not embed `/dev/input/eventXX`.
 #[derive(Debug, Clone, Default, Serialize, Deserialize)]
@@ -242,6 +266,7 @@ pub struct ResolvedConfig {
     pub safety_timeout_seconds: Option<u64>,
     pub foreground: ForegroundConfig,
     pub indicator: IndicatorConfig,
+    pub button_gesture: ButtonGestureConfig,
 }
 
 /// XDG-compliant config directory name. Lowercase by convention (and because
@@ -308,6 +333,7 @@ pub fn resolve(args: &Args) -> Result<ResolvedConfig, DaemonError> {
     let mut safety_timeout_seconds = None;
     let mut foreground = ForegroundConfig::default();
     let mut indicator = IndicatorConfig::default();
+    let mut button_gesture = ButtonGestureConfig::default();
 
     if let Some(file) = file_cfg {
         core = file.core.into_core(core);
@@ -339,6 +365,9 @@ pub fn resolve(args: &Args) -> Result<ResolvedConfig, DaemonError> {
         if let Some(ind) = file.indicator {
             indicator = ind.into_resolved();
         }
+        if let Some(bg) = file.button_gesture {
+            button_gesture = bg.into_resolved();
+        }
     }
 
     if let Some(v) = args.device.clone() {
@@ -366,6 +395,7 @@ pub fn resolve(args: &Args) -> Result<ResolvedConfig, DaemonError> {
         safety_timeout_seconds,
         foreground,
         indicator,
+        button_gesture,
     })
 }
 
